# ─────────────────────────────────────────────────────────────
# SahaBhagi Backend — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────

PORT=3001

# JWT secret — change this to a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ── Firebase ──────────────────────────────────────────────────
# Option A: Paste the entire service account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option B: Path to the downloaded service account key JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

FIREBASE_PROJECT_ID=sahabaghi-demo

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS (frontend URL) ───────────────────────────────────────
# Comma-separate multiple origins if needed. Leave unset to allow all (demo only).
FRONTEND_URL=https://sahabaghi-demo.vercel.app

# Set to "production" on your real deployment to enable HSTS headers
NODE_ENV=development

# ── Redis (pagination cache + notification queue) ──────────────────────────
# Optional for local dev — the app falls back to an in-memory cache/queue
# automatically if this is unset. Set it in production (e.g. Upstash,
# Railway, Redis Cloud) so caching + notifications are shared across
# instances. Example: redis://default:password@host:port
REDIS_URL=

# ── AI (OpenRouter — ward officer chatbot + AI-assisted stats) ─────────────
# Free tier: https://openrouter.ai/keys. If unset, the chatbot still answers
# every fixed question — just from computed stats instead of an LLM.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Google Sign-In (real OAuth — verifies the ID token server-side) ────────
# From https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client
# ID, type "Web application". Same value goes in the frontend's
# VITE_GOOGLE_CLIENT_ID. Not a secret — no client secret needed for this flow.
GOOGLE_CLIENT_ID=

# ── Email (Resend — sends signup verification codes) ───────────────────────
# Free tier: https://resend.com. If unset, OTP codes print to the server
# console instead of being emailed — fine for local dev, not for production.
RESEND_API_KEY=
MAIL_FROM=SahaBhagi <noreply@sahabhagi.org>
