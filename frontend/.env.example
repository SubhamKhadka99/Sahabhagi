# ─────────────────────────────────────────────────────────────
# SahaBhagi Frontend — Environment Variables
# Copy this to .env.local (Vite reads this)
# ─────────────────────────────────────────────────────────────

# Backend URL — your Railway/Render deployment
# Leave empty to use Vite's dev proxy (localhost:3001)
VITE_API_URL=https://your-backend.railway.app

# Cloudinary — for direct browser uploads (faster than going through backend)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sahabaghi_unsigned

# Google Sign-In — same Client ID as the backend's GOOGLE_CLIENT_ID.
# Not a secret; get it from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
